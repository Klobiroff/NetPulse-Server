<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetPulse.Server</RootNamespace>
    <AssemblyName>NetPulse.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetPulse.Common\NetPulse.Common.csproj" />
    <ProjectReference Include="..\NetPulse.Plugins\NetPulse.Plugins.csproj" />
    <ProjectReference Include="..\..\plugins\NetPulse.Plugins.Sample\NetPulse.Plugins.Sample.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\plugins\NetPulse.Plugins.AuthSample\NetPulse.Plugins.AuthSample.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="NetPulse.Server.Tests" />
  </ItemGroup>

</Project>
