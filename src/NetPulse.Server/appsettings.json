{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "NetPulse": {
    "Port": 5055,
    "ConnectionKey": "NetPulse",
    "MaxConnections": 2000,
    "AppId": "",
    "AppVersionCheck": true,
    "TickRate": 30,
    "DisconnectTimeoutMs": 10000,
    "EnableConsole": true,
    "Encryption": {
      "Mode": "Disabled",
      "PrivateKeyFile": "",
      "PreviousPrivateKeyFiles": [],
      "PreSharedKeyFile": "",
      "RequireCookie": true,
      "CookieLifetimeMs": 30000,
      "RekeyAfterPackets": 1000000,
      "RekeyAfterMs": 600000,
      "ReplayWindow": 4096,
      "SessionIdleTimeoutMs": 30000,
      "ReplaceIdleMs": 3000,
      "HandshakeTimeoutMs": 5000,
      "PaddingBlock": 0
    },
    "Security": {
      "MaxConnectionsPerIp": 32,
      "HandshakesPerIpPerSecond": 10,
      "MaxHandshakesPerSecond": 2000,
      "ConnectionAttemptsPerIpPerSecond": 20,
      "AuthDeadlineMs": 10000,
      "MaxAuthAttempts": 5,
      "MaxMessagesPerSecond": 1000,
      "MessageBurst": 2000,
      "MaxBytesPerSecond": 1048576,
      "ByteBurst": 2097152,
      "MaxMessageBytes": 262144,
      "MaxUserIdLength": 128,
      "MaxNickNameLength": 64,
      "MaxAuthTokenLength": 8192,
      "MaxRoomNameLength": 128,
      "MaxPropertiesPerRoom": 256,
      "MaxPropertyBytes": 16384,
      "MaxCachedEventsPerRoom": 4096,
      "MaxTargetActors": 256,
      "RequireRejoinToken": false
    },
    "Plugins": {
      "Directory": "plugins",
      "Default": "",
      "Auth": "",
      "HotReload": true,
      "Settings": {
        "NetPulse.Plugins.Sample": {
          "ScorePerPoint": "1"
        }
      }
    }
  }
}
