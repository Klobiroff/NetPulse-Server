<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetPulse.Plugins.AuthSample</RootNamespace>
    <ServerOutputDir>$(MSBuildThisFileDirectory)..\..\src\NetPulse.Server\bin\$(Configuration)\net10.0\plugins\NetPulse.Plugins.AuthSample\</ServerOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPulse.Plugins\NetPulse.Plugins.csproj" Private="false" />
    <ProjectReference Include="..\..\src\NetPulse.Common\NetPulse.Common.csproj" Private="false" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployToServer" AfterTargets="Build">
    <ItemGroup>
      <DeployFile Include="$(OutDir)NetPulse.Plugins.AuthSample.dll;$(OutDir)NetPulse.Plugins.AuthSample.pdb;$(OutDir)plugin.json" />
    </ItemGroup>
    <MakeDir Directories="$(ServerOutputDir)" />
    <Copy SourceFiles="@(DeployFile)" DestinationFolder="$(ServerOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
